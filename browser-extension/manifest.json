{
  "manifest_version": 3,
  "name": "Persona Companion",
  "version": "0.9.0",
  "description": "Sends the current tab's URL/title to a local Persona instance. Useful for browser-heavy use where screen OCR isn't enough.",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Persona Companion",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}

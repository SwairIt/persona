# v1.18 — данные ВНЕ репозитория, в user-home. Это значит:
#   • удалил/перустановил Persona/ — история не потерялась
#   • `git pull` ни на одном из них не затронет данные
#   • можно держать репо в любом месте, данные всегда тут
# Дефолт `~/.persona/` раскрывается в `/Users/<you>/.persona/` (Mac/Linux)
# или `C:/Users/<you>/.persona/` (Windows). Прокинь в абсолютный путь
# если хочешь внешний диск или другую папку.
PERSONA_DATA_DIR=~/.persona
PERSONA_DB_PATH=~/.persona/persona.db
PERSONA_THUMBNAILS_DIR=~/.persona/thumbnails
# v1.16 defaults: ~10 frames/min when active, 25 MB/day cap via
# budget_enforcer. Edit any line to override.
PERSONA_CAPTURE_INTERVAL_SECONDS=6
PERSONA_THUMBNAIL_QUALITY=35
PERSONA_THUMBNAIL_MAX_WIDTH=640
PERSONA_DEDUP_HAMMING_THRESHOLD=8
PERSONA_RETENTION_DAYS=180
PERSONA_IDLE_THRESHOLD_SECONDS=300

PERSONA_SMART_THUMBNAIL=true
PERSONA_SMART_MIN_GAP_SECONDS=300
PERSONA_DAILY_SIZE_BUDGET_MB=4
PERSONA_TIER_WARM_AFTER_DAYS=1
PERSONA_TIER_COLD_AFTER_DAYS=30
PERSONA_TIER_WARM_THUMBNAIL_WIDTH=256
PERSONA_TIER_WARM_THUMBNAIL_QUALITY=25
PERSONA_TIERED_RETENTION=true

PERSONA_MULTI_MONITOR=false
PERSONA_THEME=dark
PERSONA_ARCHIVE_AFTER_DAYS=180
PERSONA_ARCHIVE_ENABLED=false
PERSONA_AUTO_DIGEST_ENABLED=false
PERSONA_AUTO_DIGEST_HOUR_LOCAL=22
PERSONA_HOST=127.0.0.1
PERSONA_PORT=8765
PERSONA_LOG_LEVEL=INFO

PERSONA_TESSERACT_PATH=
PERSONA_TESSERACT_LANGS=eng+rus
PERSONA_OCR_ENABLED=false

PERSONA_BYO_API_KEY=
PERSONA_BYO_API_PROVIDER=

PERSONA_EMBEDDINGS_ENABLED=false
PERSONA_EMBEDDINGS_MODEL=intfloat/multilingual-e5-small
PERSONA_EMBEDDINGS_BATCH_SIZE=16
PERSONA_EMBEDDINGS_MIN_TEXT_LENGTH=20

# v2.20 — SMTP для писем (авторегистрация / вход по ссылке / сброс пароля).
# Gmail: заполни только USER (свой адрес) и PASS (пароль приложения) —
# FROM/TO по умолчанию = USER. App Password (нужна включённая 2FA):
#   https://myaccount.google.com/apppasswords
# Это 16-значный «пароль приложения», НЕ обычный пароль Gmail.
PERSONA_SMTP_ENABLED=true
PERSONA_SMTP_HOST=smtp.gmail.com
PERSONA_SMTP_PORT=587
PERSONA_SMTP_TLS=true
PERSONA_SMTP_USER=
PERSONA_SMTP_PASS=
# Необязательно (по умолчанию = USER):
PERSONA_SMTP_FROM=
PERSONA_SMTP_TO=

# v2.20 — ЮKassa (биллинг). Альтернатива {data_dir}/billing_secrets.json.
# shopId и секретный ключ: ЛК ЮKassa → «Интеграция» → «Ключи API».
PERSONA_YOOKASSA_SHOP_ID=
PERSONA_YOOKASSA_SECRET_KEY=
# PERSONA_YOOKASSA_LIVE=1

# Robokassa (биллинг). Тоже env ИЛИ секция "robokassa" в
# {PERSONA_DATA_DIR}/billing_secrets.json — см. app/billing/config.py.
# Все пароли берутся в ЛК Robokassa → «Мои магазины» → «Технические настройки».
# Идентификатор магазина (MerchantLogin) — не секрет, но нужен для подписи:
PERSONA_ROBOKASSA_LOGIN=
# Боевые Пароль #1 (подпись запроса) и Пароль #2 (проверка Result URL):
PERSONA_ROBOKASSA_PASSWORD1=
PERSONA_ROBOKASSA_PASSWORD2=
# Тестовые пароли — используются, когда PERSONA_ROBOKASSA_IS_TEST=1:
PERSONA_ROBOKASSA_TEST_PASSWORD1=
PERSONA_ROBOKASSA_TEST_PASSWORD2=
# Алгоритм подписи, должен совпадать с настройкой магазина
# (md5|sha1|sha256|sha384|sha512|ripemd160); пусто → дефолт из кода:
PERSONA_ROBOKASSA_HASH=
# PERSONA_ROBOKASSA_IS_TEST=1

# Read-only nightly analysis of the owner's PINNED Telegram chats.
# Create api_id/api_hash at https://my.telegram.org, then run once:
#   uv run python -m app.integrations.telegram.pinned_ingest --login
# The sensitive Telegram session stays under PERSONA_DATA_DIR, outside git.
PERSONA_TG_USER_API_ID=
PERSONA_TG_USER_API_HASH=
PERSONA_TG_PINNED_POLL_SECONDS=900
PERSONA_TG_PINNED_NIGHT_START=0
PERSONA_TG_PINNED_NIGHT_END=7

# Telegram-БОТ (отдельно от user-сессии выше): чат с Persona, автопробуждения.
# Токен бота выдаёт @BotFather (/newbot или /token). Формат <id>:AA...
PERSONA_TG_BOT_TOKEN=
# Общий секрет для привязки (pairing) нового чата к владельцу. Придумай сам,
# любая длинная случайная строка — например `python -c "import secrets;
# print(secrets.token_urlsafe(32))"`.
PERSONA_TG_PAIRING_SECRET=

# --- Воркеры на ПК владельца ---------------------------------------------
# LLM-воркер (ПК сам забирает задачи с сайта). Токен генерится на странице
# /settings/llm-worker в самой Persona — вставь сюда то же значение.
PERSONA_WORKER_TOKEN=
# Воркер удалённого браузера. Отдельный токен: он НЕ авторизует LLM-очередь
# и наоборот (см. docs/REMOTE_BROWSER_WORKER.md).
PERSONA_BROWSER_WORKER_TOKEN=
# mac-agent (сбор с Mac/второй машины) — токен устройства со страницы
# /devices. Обычно живёт в ~/.config/persona-agent.toml, env — фолбэк для CI.
PERSONA_AGENT_TOKEN=

# --- Веб-поиск ------------------------------------------------------------
# Ключ Brave Search API (https://api-dashboard.search.brave.com/, есть
# бесплатный тариф). Без него web_search падает на keyless-фолбэк (Wikipedia).
# Код читает сначала BRAVE_API_KEY, потом PERSONA_BRAVE_API_KEY.
BRAVE_API_KEY=
PERSONA_BRAVE_API_KEY=

# --- Шифрование «на диске» ------------------------------------------------
# Мастер-пароль хранилища (vault): им зашифрованы заметки и пароль
# авто-бэкапа. Задаёшь его сам при первой настройке /settings/vault; воркеру
# авто-бэкапа он нужен в env, иначе тот просто спит.
PERSONA_VAULT_MASTER_PASSWORD=
# Парольная фраза для ручного шифрованного бэкапа (.pbkx), минимум 12
# символов. Задаёшь сам; потерял — архив не расшифровать.
#   scripts/encrypted_backup.py читает PERSONA_BACKUP_PASSPHRASE
#   app/cli.py (persona backup) читает PERSONA_BACKUP_PASSWORD
PERSONA_BACKUP_PASSPHRASE=
PERSONA_BACKUP_PASSWORD=

# --- Сеть -----------------------------------------------------------------
# Доверенные прокси: чьему X-Forwarded-For можно верить при определении IP
# клиента (rate-limit, аудит). Список IP/CIDR через запятую. Не секрет, но
# ошибка тут = подделка IP. Пусто → дефолт из app/auth/proxies.py.
#   PERSONA_TRUSTED_PROXIES="127.0.0.1,10.0.0.0/8"
PERSONA_TRUSTED_PROXIES=

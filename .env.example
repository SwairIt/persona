# v1.18 — данные ВНЕ репозитория, в user-home. Это значит:
#   • удалил/перустановил Persona/ — история не потерялась
#   • `git pull` ни на одном из них не затронет данные
#   • можно держать репо в любом месте, данные всегда тут
# Дефолт `~/.persona/` раскрывается в `/Users/<you>/.persona/` (Mac/Linux)
# или `C:/Users/<you>/.persona/` (Windows). Прокинь в абсолютный путь
# если хочешь внешний диск или другую папку.
PERSONA_DATA_DIR=~/.persona
PERSONA_DB_PATH=~/.persona/persona.db
PERSONA_THUMBNAILS_DIR=~/.persona/thumbnails
# v1.16 defaults: ~10 frames/min when active, 25 MB/day cap via
# budget_enforcer. Edit any line to override.
PERSONA_CAPTURE_INTERVAL_SECONDS=6
PERSONA_THUMBNAIL_QUALITY=35
PERSONA_THUMBNAIL_MAX_WIDTH=640
PERSONA_DEDUP_HAMMING_THRESHOLD=8
PERSONA_RETENTION_DAYS=180
PERSONA_IDLE_THRESHOLD_SECONDS=300

PERSONA_SMART_THUMBNAIL=true
PERSONA_SMART_MIN_GAP_SECONDS=300
PERSONA_DAILY_SIZE_BUDGET_MB=4
PERSONA_TIER_WARM_AFTER_DAYS=1
PERSONA_TIER_COLD_AFTER_DAYS=30
PERSONA_TIER_WARM_THUMBNAIL_WIDTH=256
PERSONA_TIER_WARM_THUMBNAIL_QUALITY=25
PERSONA_TIERED_RETENTION=true

PERSONA_MULTI_MONITOR=false
PERSONA_THEME=dark
PERSONA_ARCHIVE_AFTER_DAYS=180
PERSONA_ARCHIVE_ENABLED=false
PERSONA_AUTO_DIGEST_ENABLED=false
PERSONA_AUTO_DIGEST_HOUR_LOCAL=22
PERSONA_HOST=127.0.0.1
PERSONA_PORT=8765
PERSONA_LOG_LEVEL=INFO

PERSONA_TESSERACT_PATH=
PERSONA_TESSERACT_LANGS=eng+rus
PERSONA_OCR_ENABLED=false

PERSONA_BYO_API_KEY=
PERSONA_BYO_API_PROVIDER=

PERSONA_EMBEDDINGS_ENABLED=false
PERSONA_EMBEDDINGS_MODEL=intfloat/multilingual-e5-small
PERSONA_EMBEDDINGS_BATCH_SIZE=16
PERSONA_EMBEDDINGS_MIN_TEXT_LENGTH=20

# v2.20 — SMTP для писем (авторегистрация / вход по ссылке / сброс пароля).
# Gmail: заполни только USER (свой адрес) и PASS (пароль приложения) —
# FROM/TO по умолчанию = USER. App Password (нужна включённая 2FA):
#   https://myaccount.google.com/apppasswords
# Это 16-значный «пароль приложения», НЕ обычный пароль Gmail.
PERSONA_SMTP_ENABLED=true
PERSONA_SMTP_HOST=smtp.gmail.com
PERSONA_SMTP_PORT=587
PERSONA_SMTP_TLS=true
PERSONA_SMTP_USER=
PERSONA_SMTP_PASS=
# Необязательно (по умолчанию = USER):
PERSONA_SMTP_FROM=
PERSONA_SMTP_TO=

# v2.20 — ЮKassa (биллинг). Альтернатива {data_dir}/billing_secrets.json.
# PERSONA_YOOKASSA_SHOP_ID=
# PERSONA_YOOKASSA_SECRET_KEY=
# PERSONA_YOOKASSA_LIVE=1

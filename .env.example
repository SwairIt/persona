PERSONA_DATA_DIR=./data
PERSONA_DB_PATH=./data/persona.db
PERSONA_THUMBNAILS_DIR=./data/thumbnails
# v1.16 defaults: ~10 frames/min when active, 25 MB/day cap via
# budget_enforcer. Edit any line to override.
PERSONA_CAPTURE_INTERVAL_SECONDS=6
PERSONA_THUMBNAIL_QUALITY=35
PERSONA_THUMBNAIL_MAX_WIDTH=640
PERSONA_DEDUP_HAMMING_THRESHOLD=8
PERSONA_RETENTION_DAYS=180
PERSONA_IDLE_THRESHOLD_SECONDS=300

PERSONA_SMART_THUMBNAIL=true
PERSONA_SMART_MIN_GAP_SECONDS=300
PERSONA_DAILY_SIZE_BUDGET_MB=4
PERSONA_TIER_WARM_AFTER_DAYS=1
PERSONA_TIER_COLD_AFTER_DAYS=30
PERSONA_TIER_WARM_THUMBNAIL_WIDTH=256
PERSONA_TIER_WARM_THUMBNAIL_QUALITY=25
PERSONA_TIERED_RETENTION=true

PERSONA_MULTI_MONITOR=false
PERSONA_THEME=dark
PERSONA_ARCHIVE_AFTER_DAYS=180
PERSONA_ARCHIVE_ENABLED=false
PERSONA_AUTO_DIGEST_ENABLED=false
PERSONA_AUTO_DIGEST_HOUR_LOCAL=22
PERSONA_HOST=127.0.0.1
PERSONA_PORT=8765
PERSONA_LOG_LEVEL=INFO

PERSONA_TESSERACT_PATH=
PERSONA_TESSERACT_LANGS=eng+rus
PERSONA_OCR_ENABLED=false

PERSONA_BYO_API_KEY=
PERSONA_BYO_API_PROVIDER=

PERSONA_EMBEDDINGS_ENABLED=false
PERSONA_EMBEDDINGS_MODEL=intfloat/multilingual-e5-small
PERSONA_EMBEDDINGS_BATCH_SIZE=16
PERSONA_EMBEDDINGS_MIN_TEXT_LENGTH=20
